# Copiá este archivo a ".env" y completá los valores reales. Ninguna de estas
# variables existe todavía en el código (las integraciones siguen simuladas —
# ver docs/INTEGRACIONES.md) — este archivo documenta lo que va a hacer falta
# a medida que se vayan conectando de verdad.

# --- Ya en uso hoy ---

# Puerto donde escucha el servidor local.
PORT=3000

# Firma las cookies de sesión. Si no la definís, se genera una al azar en
# cada arranque (las sesiones no sobreviven un reinicio, pero tampoco queda
# ningún secreto fijo en el repo). En producción, definila con un valor largo
# y random, y no la cambies (o vas a desloguear a todo el mundo).
SESSION_SECRET=

# --- Para cuando se conecten las integraciones reales (ver docs/INTEGRACIONES.md) ---

# 1. Pagos (banco / PSP)
# PSP_API_URL=
# PSP_API_KEY=
# PSP_CUENTA_ORIGEN=

# 2. Firma digital (AFIP o proveedor externo)
# FIRMA_DIGITAL_PROVEEDOR=afip   # afip | docusign | yousign
# FIRMA_DIGITAL_API_KEY=

# 3. Verificación de identidad (KYC/KYB)
# KYC_PROVIDER=sumsub   # sumsub | veriff | onfido
# KYC_API_KEY=

# 4. Factura electrónica (ARCA)
# ARCA_CERTIFICADO_PATH=
# ARCA_CLAVE_FISCAL=

# 5. Notificaciones (email / SMS)
# EMAIL_PROVIDER=resend   # resend | sendgrid | ses
# EMAIL_API_KEY=
# EMAIL_FROM=notificaciones@fondossa.com.ar
# SMS_PROVIDER=twilio
# SMS_API_KEY=
